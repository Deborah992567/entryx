# EntryX backend environment — copy to .env and adjust.
# SQLite (default for local dev):
DATABASE_URL=sqlite:///./entryx.db
# MariaDB (production):
# DATABASE_URL=mysql+pymysql://entryx:entryx@localhost:3306/entryx?charset=utf8mb4

# Security
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
# Fernet key (32 url-safe base64 bytes) for broker credential encryption.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# App
APP_NAME=EntryX
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173","tauri://localhost"]

# AI provider (local-first; never a paid API)
AI_PROVIDER=ollama
AI_OLLAMA_URL=http://localhost:11434
AI_DEFAULT_MODEL=qwen2.5:1.5b

# Paper broker defaults
PAPER_INITIAL_BALANCE=100000
PAPER_LEVERAGE=100
